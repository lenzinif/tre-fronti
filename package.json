{
  "name": "tre-fronti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cli": "npm run build:cli --silent && node cli/index.mjs",
    "build:cli": "tsc -p tsconfig.cli.json",
    "server": "npm run build:cli --silent && node server/index.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run build:cli --silent",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.2"
  }
}
